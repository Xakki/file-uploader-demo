COMPOSE_PROFILES=dev
COMPOSE_PROJECT_NAME=file_uploader_demo
COMPOSE_FILE=docker-compose.yml

DOCKER_IMAGE_PHP=harbor.xakki.ru/library/php:8.5-fpm-dev
DOCKER_IMAGE_NGINX=harbor.xakki.ru/external/nginx

EXT_NGINX_PORT=127.0.0.1:80

APP_ENV=dev
APP_URL=https://file-uploader.xakki.ru
TZ=UTC
COMPOSER_NO_DEV=0

# Demo caps
FU_MAX_SIZE=52428800
FU_MAX_FILES=15
EXPIRE_MINUTES=60
GC_INTERVAL=300

# Storage target: local | s3  (s3 needs the s3.yml overlay — see `make s3-up`).
STORAGE=local

# S3 (MinIO) — used when STORAGE=s3 (s3.yml overlay).
#S3_ENDPOINT=http://minio:9000
#S3_KEY=minioadmin
#S3_SECRET=minioadmin
#S3_BUCKET=uploads
#S3_REGION=us-east-1


GRAYLOG_HOST=
GRAYLOG_URI=/gelf
GRAYLOG_PORT=443
